{
  "name": "ppts",
  "type": "module",
  "private": true,
  "description": "Slidev presentations: one folder per deck in decks/, shared looks in templates/.",
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node scripts/deck.mjs dev",
    "build": "node scripts/deck.mjs build",
    "export": "node scripts/deck.mjs export",
    "new": "node scripts/deck.mjs new",
    "decks": "node scripts/deck.mjs list",
    "installCommand": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 pnpm install --frozen-lockfile"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@lucide/vue": "1.50.0",
    "@slidev/cli": "^53.0.0",
    "@slidev/client": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "@slidev/theme-seriph": "^0.25.0",
    "@tailwindcss/vite": "4.3.3",
    "@vueuse/core": "14.4.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "reka-ui": "2.10.5",
    "shiki": "4.4.3",
    "slidev-addon-shadcn": "link:addons/shadcn",
    "tailwindcss": "4.3.3",
    "vue": "^3.5.33"
  },
  "devDependencies": {
    "playwright-chromium": "^1.63.0"
  }
}
