{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@shadcn/*": ["./src/*"]
    }
  },
  "include": ["src/**/*", "components/**/*", "setup/**/*"]
}
