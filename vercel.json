{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1 npx --yes pnpm@11.10.0 install --frozen-lockfile",
  "buildCommand": "node scripts/deck.mjs build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/:deck/:path*", "destination": "/:deck/index.html" }
  ]
}
