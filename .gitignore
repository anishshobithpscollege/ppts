# Dependencies (root and per-deck)
node_modules/
.pnpm-store/

# Site build: `pnpm build` writes dist/<deck>/ plus dist/index.html
dist/

# Slidev generated files
.slidev/
.vite-inspect/
.remote-assets/
components.d.ts
slides-export/
*.local

# Deploy tooling state (created by `vercel link` / `vercel pull` / `netlify link`)
.vercel/
.netlify/

# Environment files (keep the example)
.env
.env.*
!.env.example

# Logs
*.log
pnpm-debug.log*
# ...except sample logs that slides import with `?raw` (decks/<deck>/snippets/access.log)
!decks/*/snippets/*.log

# Tool caches
.cache/
.eslintcache
*.tsbuildinfo
.vite/
vite.config.*.timestamp-*

# Scratch space for throwaway scripts and probes
.tmp/

# Office temp/lock files left next to exports while a PPTX is open
~$*
.~lock.*#

# Python (scripts/pptx-widescreen.py)
__pycache__/
*.py[cod]

# Editors and OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Claude Code: per-machine settings and agent worktrees (launch.json and skills stay tracked)
.claude/settings.local.json
.claude/worktrees/
.vercel
.env*
