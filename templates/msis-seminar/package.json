{
  "name": "slidev-template-msis-seminar",
  "version": "1.0.0",
  "private": true,
  "description": "MSIS (MAHE) Seminar Template 2026-27 for Slidev: 16:9, Calibri, CC6600 rule, institute footer.",
  "engines": {
    "slidev": ">=52.0.0"
  },
  "slidev": {
    "colorSchema": "light",
    "defaults": {
      "aspectRatio": "16/9",
      "canvasWidth": 960,
      "colorSchema": "light",
      "titleTemplate": "%s",
      "transition": "none",
      "lineNumbers": false,
      "timer": "stopwatch",
      "drawings": {
        "persist": false
      },
      "fonts": {
        "sans": "Calibri",
        "mono": "Courier New",
        "provider": "none"
      }
    }
  }
}
